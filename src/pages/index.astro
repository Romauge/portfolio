---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getProjets, htmlOf, subtitleHtml } from '../lib/content';

const hero = await getEntry('home', 'hero');
const long = await getEntry('home', 'bio-long');
const projets = await getProjets();

const experiences = [
    { company: 'Matera', role: 'Staff product designer.', url: 'https://www.matera.eu', years: '2021 - actuel' },
    { company: 'Bridge', role: 'Product designer.', url: 'https://bridgeapi.io', years: '2019 - 2021' },
    { company: 'Bankin’', role: 'Product designer.', url: 'https://bankin.com', years: '2019 - 2021' },
    { company: 'Brevo', role: 'UI & UX designer.', url: 'https://www.brevo.com', years: '2016 - 2019' },
    { company: 'Plyce', role: 'Webdesigner.', years: '2014 - 2016' },
];
---
<Base title="Home" bodyClass="title-center title-h1h2 header-fixed">
    <div id="hero" class="module-anchor"></div>

    <section class={`ui-intro ${hero?.data.class ?? ''}`}>
        <div class="ui-identity">
            <div class="ui-avatar" aria-hidden="true"><img src="/images/avatar.svg" alt="" width="64" height="64" /></div>
            <div>
                <h1 class="ui-name">{hero?.data.name}</h1>
                {hero?.data.role && <p class="ui-role">{hero.data.role}</p>}
            </div>
        </div>

        {long ? (
            <>
                <div class="ui-section-head">
                    <h2 class="ui-h2">Bio</h2>
                    <span class="ui-tabs-list" role="tablist" aria-label="Bio">
                        <button type="button" role="tab" aria-selected="true" data-bio="default">Défaut</button>
                        <button type="button" role="tab" aria-selected="false" data-bio="long">Longue</button>
                    </span>
                </div>
                <div class="ui-prose" data-bio-panel="default" set:html={htmlOf(hero)} />
                <div class="ui-prose" data-bio-panel="long" hidden set:html={htmlOf(long)} />
                <script is:inline src="/js/bio-tabs.js"></script>
            </>
        ) : (
            <div class="ui-prose" set:html={htmlOf(hero)} />
        )}
    </section>

    <div id="projets" class="module-anchor"></div>

    <section class="ui-section modular-work-list">
        <h2 class="ui-h2">Projets</h2>
        <div class="ui-projects">
            {projets.map((p) => (
                <ProjectRow href={`/projets/${p.id}`} title={p.data.title} subtitle={subtitleHtml(p)} image={p.data.image} />
            ))}
        </div>
    </section>
    <section class="ui-section">
        <h2 class="ui-h2">Où j’ai travaillé</h2>
        <ul class="ui-jobs">
            {experiences.map((e) => (
                <li>
                    <div class="ui-job">
                        <span class="ui-job-main">
                            {e.url
                                ? <a class="ui-job-company" href={e.url} target="_blank" rel="noopener noreferrer">{e.company}<span class="ui-job-arrow" aria-hidden="true"> ↗</span></a>
                                : <span class="ui-job-company">{e.company}</span>}
                            <span class="ui-job-role">{e.role}</span>
                        </span>
                        <span class="ui-job-meta">
                            <span class="ui-job-years">{e.years}</span>
                        </span>
                    </div>
                </li>
            ))}
        </ul>
    </section>
    <script is:inline src="/js/thumb-tilt.js"></script>
</Base>
